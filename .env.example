# Supabase (for missions app) — client uses URL + anon key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: service role key for Publish (bypasses RLS). If not set, anon key is used.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Run setup once: pnpm setup-missions-db (creates tables, seeds players + Day 1 missions)
# Get from Supabase: Project Settings > Database > Connection string > URI
DATABASE_URL=postgresql://postgres.[ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres

# Optional: missions WhatsApp group invite for "Post Proof" button (default: Costa2k26 MISSIONS group)
NEXT_PUBLIC_MISSIONS_WHATSAPP_LINK=https://chat.whatsapp.com/L0x5icO0sC1JgfFK8qK05q

# Optional: Admin AI mission generation
OPENAI_API_KEY=sk-...

# Admin PIN (4 digits). Required to open Admin panel when logged in as Mathushan. Default: 8181
NEXT_PUBLIC_ADMIN_PIN=8181
